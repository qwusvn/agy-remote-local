<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Tia năng lượng lơ lửng ở đỉnh (Antigravity Core) -->
    <path
        android:pathData="M54,25 L63,35 L54,45 L45,35 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="45"
                android:startY="25"
                android:endX="63"
                android:endY="45"
                android:type="linear">
                <item android:color="#00F5D4" android:offset="0.0" />
                <item android:color="#00BBF9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cánh trái chữ A (Antigravity Left Wing) -->
    <path
        android:pathData="M48,47 L30,81 L38,81 L53,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="81"
                android:endX="53"
                android:endY="47"
                android:type="linear">
                <item android:color="#7B2CBF" android:offset="0.0" />
                <item android:color="#00BBF9" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Cánh phải chữ A (Antigravity Right Wing) -->
    <path
        android:pathData="M60,47 L78,81 L70,81 L55,52 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="78"
                android:startY="81"
                android:endX="55"
                android:endY="47"
                android:type="linear">
                <item android:color="#9D4EDD" android:offset="0.0" />
                <item android:color="#00F5D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Thanh ngang liên kết lượng tử (Quantum Bridge) -->
    <path
        android:pathData="M37,67 L71,67 L69,63 L39,63 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="37"
                android:startY="65"
                android:endX="71"
                android:endY="65"
                android:type="linear">
                <item android:color="#00BBF9" android:offset="0.0" />
                <item android:color="#F72585" android:offset="0.5" />
                <item android:color="#7209B7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Hạt phát sáng ở trung tâm chữ A -->
    <path
        android:pathData="M54,58 A3,3 0 1 0 54,64 A3,3 0 1 0 54,58 Z"
        android:fillColor="#FFFFFF" />

</vector>